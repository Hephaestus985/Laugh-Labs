; Engine configuration file.
config_version=5

[application]

config/quit_on_go_back=false

config/name="Lab Arcade"
config/version="1.28"
config/use_custom_user_dir=true
config/custom_user_dir_name="Laugh Lab Arcade"
config/description="All the Lab games in one app."
run/main_scene="res://menu.tscn"
run/main_scene.smoketest="res://tools/tests/run_tests.tscn"
run/main_scene.packtest="res://tools/tests/pack_test.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.3")

[dialogic]

text/skippable=true
text/skippable_delay=0.05
text/autoadvance_delay=1.0
text/hide_empty_textbox=true
animations/join_default_length=0.0
animations/leave_default_length=0.0
animations/leave_default_wait=false
animations/join_default_wait=false
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
text/autopauses={}
glossary/default_case_sensitive=true
layout/mode=2
variables={
"BlueWandCount": 0,
"GreenWandCount": 0,
"HasMonkToken": 0,
"HasThiefToken": 0,
"HasWarriorToken": 0,
"HasWizardToken": 0,
"Hint": 0,
"RedWandCount": 0,
"StrangeTreeExamined": 0,
"TokenCount": 0,
"TokenQuestStatus": 0
}
layout/end_behaviour=0
layout/styles={
"Default": {
"export_overrides": {},
"inherits": "",
"layout": "res://external/open_rpg/dialogue_layout.tscn"
}
}
layout/default_style="Default"
text/letter_speed=0.02
animations/join_default="Instant In"
animations/leave_default="Instant Out"
text/autocolor_names=true
settings/text_speed=1.0
directories/dch_directory={
"enemy_ghost": "res://external/open_rpg/overworld/maps/town/enemy_ghost.dch",
"fan_of_four": "res://external/open_rpg/overworld/maps/town/fan_of_four.dch",
"ghost": "res://external/open_rpg/overworld/maps/forest/ghost.dch",
"monk": "res://external/open_rpg/overworld/maps/town/monk.dch",
"runner": "res://external/open_rpg/overworld/maps/town/runner.dch",
"smith": "res://external/open_rpg/overworld/maps/town/smith.dch",
"thief": "res://external/open_rpg/overworld/maps/town/thief.dch",
"warrior": "res://external/open_rpg/overworld/maps/town/warrior.dch",
"wizard": "res://external/open_rpg/overworld/maps/town/wizard.dch"
}
directories/dtl_directory={
"encounter_before_combat": "res://external/open_rpg/overworld/maps/town/encounter_before_combat.dtl",
"encounter_on_loss": "res://external/open_rpg/overworld/maps/town/encounter_on_loss.dtl",
"encounter_on_victory": "res://external/open_rpg/overworld/maps/town/encounter_on_victory.dtl",
"fan_of_four": "res://external/open_rpg/overworld/maps/town/fan_of_four.dtl",
"ghost": "res://external/open_rpg/overworld/maps/forest/ghost.dtl",
"monk": "res://external/open_rpg/overworld/maps/town/monk.dtl",
"opening_cutscene": "res://external/open_rpg/overworld/maps/opening_cutscene.dtl",
"runner": "res://external/open_rpg/overworld/maps/town/runner.dtl",
"sign": "res://external/open_rpg/overworld/maps/town/sign.dtl",
"smith": "res://external/open_rpg/overworld/maps/town/smith.dtl",
"strange_tree": "res://external/open_rpg/overworld/maps/town/strange_tree.dtl",
"thief": "res://external/open_rpg/overworld/maps/town/thief.dtl",
"wand_pedestal": "res://external/open_rpg/overworld/maps/house/wand_pedestal.dtl",
"wand_pedestal_occupied": "res://external/open_rpg/overworld/maps/house/wand_pedestal_occupied.dtl",
"warrior": "res://external/open_rpg/overworld/maps/town/warrior.dtl",
"wizard": "res://external/open_rpg/overworld/maps/town/wizard.dtl"
}
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.05
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
save/encryption_on_exports_only=true
text/advance_delay=0.1
portraits/default_portrait=""
layout/style_list=[]
extensions_folder="res://external/open_rpg/addons/dialogic_additions"
audio/max_channels=4.0
animations/cross_fade_default_length=0.5
layout/style_directory={}

[display]

window/handheld/orientation=6

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.15, 1)
textures/vram_compression/import_etc2_astc=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[autoload]

Global="*res://external/outpost_assault/assets/scripts/global.gd"
Scenes="*res://external/outpost_assault/assets/scripts/scenes.gd"
Audio="*res://external/platformer_3d/scripts/audio.gd"
Camera="*res://external/open_rpg/src/field/field_camera.gd"
