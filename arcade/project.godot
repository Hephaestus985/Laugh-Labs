; Engine configuration file.
config_version=5

[application]

config/quit_on_go_back=false

config/name="Lab Arcade"
config/version="1.7"
config/use_custom_user_dir=true
config/custom_user_dir_name="Laugh Lab Arcade"
config/description="All the Lab games in one app."
run/main_scene="res://menu.tscn"
run/main_scene.smoketest="res://tools/tests/run_tests.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.3")

[display]

window/handheld/orientation=6

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.15, 1)
textures/vram_compression/import_etc2_astc=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[autoload]

Global="*res://external/outpost_assault/assets/scripts/global.gd"
Scenes="*res://external/outpost_assault/assets/scripts/scenes.gd"

[input]

middle_mouse={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":3,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}

[layer_names]

2d_physics/layer_1="infantry"
2d_navigation/layer_1="ground"
2d_physics/layer_2="turret"
2d_navigation/layer_2="air"
2d_physics/layer_3="projectile"
2d_physics/layer_4="turret_slot"
2d_physics/layer_5="objective"
2d_physics/layer_6="tank"
2d_physics/layer_7="helicopter"
